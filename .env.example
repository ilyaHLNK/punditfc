# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database ---------------------------------------------------------------
# Port 5434 matches the host mapping in docker-compose.yml.
DATABASE_URL="postgresql://punditfc:punditfc@localhost:5434/punditfc?schema=public"

# --- Redis ------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- API --------------------------------------------------------------------
NODE_ENV="development"
API_PORT="3001"
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- External football data -------------------------------------------------
# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_URL="https://api.football-data.org/v4"
FOOTBALL_DATA_API_TOKEN=""
# Competition codes synced in v1: Premier League, La Liga, Serie A, Bundesliga.
COMPETITION_CODES="PL,PD,SA,BL1"

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
